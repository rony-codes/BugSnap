
{
  "manifest_version": 3,
  "name": "BugSnap Beta",
  "version": "0.1.0",
  "description": "Record browser interactions and generate structured bug reports. Beta testing build.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://bugsnap-9nc9.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BugSnap",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
